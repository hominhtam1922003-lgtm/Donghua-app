<resources>
    <!-- Giao dien DEN dien anh (tu v1.0.2 theo yeu cau cua chu app):
         nen gan nhu den tuyen, the phim xam dam vien mong, diem nhan
         do phim (khop logo Tru Tien), chu trang/xam sang de doc. -->
    <style name="Theme.TruyenReader" parent="Theme.Material3.Dark">
        <item name="colorPrimary">#E50914</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#4A0D11</item>
        <item name="colorOnPrimaryContainer">#FFD9DB</item>
        <item name="colorSecondary">#F5C518</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSurface">#101014</item>
        <item name="colorOnSurface">#F4F4F6</item>
        <item name="colorSurfaceVariant">#1B1B21</item>
        <item name="colorOnSurfaceVariant">#A8A8B3</item>
        <item name="colorOutline">#2C2C34</item>
        <item name="android:windowBackground">#060608</item>
        <item name="android:statusBarColor">#060608</item>
        <item name="android:navigationBarColor">#060608</item>
    </style>

    <style name="BottomTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
