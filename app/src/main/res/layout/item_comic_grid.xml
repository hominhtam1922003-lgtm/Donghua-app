<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardBackgroundColor="#141419"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="#232329"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Chieu cao poster do CODE dat theo dung ti le 2:3 cua web
             (xem gridPosterHeightPx trong Adapters.kt). Ban 1.0.2 dung
             ConstraintLayout + dimensionRatio trong RecyclerView lam
             cac the bi do sai kich thuoc, chong len nhau; ban 1.0 dung
             chieu cao co dinh 130dp thi cat mat phan tren poster. -->
        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:contentDescription="Ảnh bìa"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingTop="5dp"
            android:paddingEnd="6dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLatest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="9sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
